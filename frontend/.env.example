# Optional: set when frontend and backend are served from different origins.
# Leave empty to use the same-origin /api endpoint (recommended with a reverse proxy).
REACT_APP_BACKEND_URL=

# Must match backend TIMEZONE. This value is embedded into the frontend at build time.
REACT_APP_TIMEZONE=Europe/Dublin

# Optional: enable the extra Webpack/dev-server health-check endpoints.
ENABLE_HEALTH_CHECK=false
