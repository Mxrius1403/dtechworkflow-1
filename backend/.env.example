# Copy to .env and replace every placeholder. Never commit .env.
MONGO_URL=mongodb://localhost:27017
DB_NAME=dtechworkflow
CORS_ORIGINS=http://localhost:3000

# Owner account provisioned/updated when the backend starts.
OWNER_NAME=Dentaltech Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-bytes

# Set true when deployed behind HTTPS.
AUTH_COOKIE_SECURE=false
