# Copy to .env and replace every placeholder. Never commit .env.
MONGO_URL=mongodb://localhost:27017
DB_NAME=dtechworkflow
HOST=0.0.0.0
PORT=8001

# Public URL(s) of the frontend, comma-separated, without a trailing slash.
CORS_ORIGINS=http://localhost:3000

# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-bytes

# Set true when deployed behind HTTPS.
AUTH_COOKIE_SECURE=false

# IANA timezone used for server-side operational dates and times.
TIMEZONE=Europe/Dublin
